{
  "name": "steward-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun build packages/cli/src/main.ts --outfile packages/cli/dist/cli.js --target node",
    "compile": "bun build --compile --minify packages/cli/src/main.ts --outfile packages/cli/dist/steward",
    "dev": "bun --watch packages/cli/src/main.ts",
    "start": "bun packages/cli/src/main.ts",
    "test": "bun test",
    "format": "bun ./node_modules/prettier/bin/prettier.cjs --check \"packages/*/src/**/*.{ts,tsx,js,jsx}\" \"packages/*/tests/**/*.{ts,tsx,js,jsx}\"",
    "format:fix": "bun ./node_modules/prettier/bin/prettier.cjs --write \"packages/*/src/**/*.{ts,tsx,js,jsx}\" \"packages/*/tests/**/*.{ts,tsx,js,jsx}\"",
    "lint:boundaries": "bun test packages/cli/tests/boundary-lint.test.ts",
    "typecheck": "tsc --noEmit -p packages/ai && tsc --noEmit -p packages/tui && tsc --noEmit -p packages/oauth && tsc --noEmit -p packages/agent && tsc --noEmit -p packages/cli"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "typescript": "^7.0.2"
  }
}
