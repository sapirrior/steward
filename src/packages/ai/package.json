{
  "name": "@steward/ai",
  "version": "0.1.0",
  "description": "Zero-dependency streaming AI inference library for Steward",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node/index.ts",
    "./testing": "./src/testing/faux.ts"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./tests",
    "check:invariants": "bun run ./scripts/check-invariants.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2"
  }
}
