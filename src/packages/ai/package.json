{
  "name": "@steward/ai",
  "version": "0.1.0",
  "description": "Zero-dependency streaming AI inference library for Steward",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./src/index.ts"
    },
    "./testing": {
      "bun": "./src/testing/faux.ts",
      "import": "./dist/testing/faux.js",
      "types": "./src/testing/faux.ts"
    }
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "bun build ./src/index.ts ./src/testing/faux.ts --outdir ./dist --target node",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./tests",
    "catalog:update": "bun run scripts/generate-catalog.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2"
  }
}
