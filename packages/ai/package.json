{
  "name": "@steward/ai",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-dependency streaming AI inference library for Steward",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./testing": {
      "bun": "./src/testing/faux.ts",
      "import": "./src/testing/faux.ts",
      "default": "./src/testing/faux.ts",
      "types": "./src/testing/faux.ts"
    }
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "bun build ./src/index.ts ./src/testing/faux.ts --outdir ./dist --target node",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./tests",
    "chat": "bun run examples/chat.ts"
  },

  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2"
  }
}
