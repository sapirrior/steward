{
  "name": "@steward/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend-neutral streaming agent engine for Steward built on Vercel AI SDK",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.78",
    "@ai-sdk/deepseek": "3.0.63",
    "@ai-sdk/google": "4.0.93",
    "@ai-sdk/groq": "4.0.59",
    "@ai-sdk/mistral": "4.0.62",
    "@ai-sdk/openai": "4.0.91",
    "@ai-sdk/openai-compatible": "3.0.67",
    "@ai-sdk/xai": "5.0.20",
    "ai": "7.0.137"
  },
  "devDependencies": {
    "@types/bun": "1.4.2"
  }
}
