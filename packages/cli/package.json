{
  "name": "steward-cli",
  "version": "0.30.0",
  "description": "Interactive AI engineering assistant for the terminal.",
  "author": "sapirrior",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sapirrior/steward.git"
  },
  "bugs": {
    "url": "https://github.com/sapirrior/steward/issues"
  },
  "homepage": "https://github.com/sapirrior/steward#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "bin": {
    "steward": "dist/cli.js",
    "steward-cli": "dist/cli.js"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "prepublishOnly": "bun run build",
    "build": "bun build src/main.ts --outfile ./dist/cli.js --target node",
    "compile": "bun build --compile --minify src/main.ts --outfile ./dist/steward",
    "format": "bun ./node_modules/prettier/bin/prettier.cjs --check \"src/**/*.{ts,tsx,js,jsx}\" \"tests/**/*.{ts,tsx,js,jsx}\"",
    "format:fix": "bun ./node_modules/prettier/bin/prettier.cjs --write \"src/**/*.{ts,tsx,js,jsx}\" \"tests/**/*.{ts,tsx,js,jsx}\"",
    "lint:boundaries": "bun test tests/boundary-lint.test.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@steward/agent": "*",
    "@steward/ai": "*",
    "@steward/oauth": "*",
    "chalk": "6.0.0",

    "cli-highlight": "2.1.11",
    "marked": "18.0.12",
    "stitchable": "*",
    "string-width": "8.2.2",
    "strip-ansi": "7.2.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "prettier": "3.9.6"
  }
}
