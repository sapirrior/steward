{
  "name": "steward-cli",
  "version": "0.38.0",
  "description": "Interactive AI engineering assistant for the terminal.",
  "author": "sapirrior",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sapirrior/steward.git"
  },
  "bugs": {
    "url": "https://github.com/sapirrior/steward/issues"
  },
  "homepage": "https://github.com/sapirrior/steward#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "bin": {
    "steward": "dist/cli.js",
    "steward-cli": "dist/cli.js"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "prepublishOnly": "bun run build",
    "build": "bun build src/main.ts --outfile ./dist/cli.js --target node",
    "compile": "bun build --compile --minify src/main.ts --outfile ./dist/steward",
    "format": "bun ./node_modules/prettier/bin/prettier.cjs --check \"src/**/*.{ts,tsx,js,jsx}\"",
    "format:fix": "bun ./node_modules/prettier/bin/prettier.cjs --write \"src/**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.78",
    "@ai-sdk/deepseek": "3.0.63",
    "@ai-sdk/google": "4.0.93",
    "@ai-sdk/groq": "4.0.59",
    "@ai-sdk/mistral": "4.0.62",
    "@ai-sdk/openai": "4.0.91",
    "@ai-sdk/openai-compatible": "3.0.67",
    "@ai-sdk/xai": "5.0.20",
    "@steward/models": "*",
    "@steward/oauth": "*",
    "@steward/threads": "*",
    "ai": "7.0.137",
    "chalk": "6.0.0",
    "cli-highlight": "2.1.11",
    "commander": "15.0.0",
    "marked": "18.0.12",
    "stitchable": "*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "prettier": "3.9.6"
  }
}
