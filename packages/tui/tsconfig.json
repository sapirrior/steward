{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "stitchable",
    "types": ["bun"],
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "stitchable": ["./src/index.ts"],
      "stitchable/*": ["./src/*"]
    }
  },

  "include": ["src", "tests", "bench", "examples"]
}
