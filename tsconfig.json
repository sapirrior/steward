{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "steward/tui/*": ["./src/packages/tui/src/*"],
      "steward/tui/jsx-runtime": ["./src/packages/tui/src/jsx-runtime.ts"],
      "steward/tui/jsx-dev-runtime": ["./src/packages/tui/src/jsx-dev-runtime.ts"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "steward/tui",
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*", "tests/**/*"]
}
